{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "declarationDir": "lib/types",
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["../../new/test-renat3u/vendor/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-host-webserver": ["../../new/test-renat3u/packages/host/webserver/lib/types/index.d.ts"]
    }
  },
  "include": ["src"]
}
