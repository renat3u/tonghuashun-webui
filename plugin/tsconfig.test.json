{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false,
    "outDir": ".test-dist",
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["../../test-renat3u/vendor/cordis/lib/types/index.d.ts"]
    },
    "types": ["node"]
  },
  "include": ["src", "tests"],
  "exclude": ["src/index.ts"]
}
